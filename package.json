{
  "name": "rillroot",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "tunaon",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm run build:shared && pnpm run build:ui && turbo run dev",
    "build": "turbo run build",
    "build:shared": "turbo run build --filter=@rillroot/shared",
    "build:ui": "turbo run build --filter=@rillroot/ui",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@rillroot/eslint-config": "workspace:*",
    "@rillroot/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  }
}
